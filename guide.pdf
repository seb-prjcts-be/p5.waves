(  for \(let y = 0; y <= height; y += 8\) {) Tj
T*
(    const x = Waves.wave\(y + t, 'classicSine', null, { amplitude: 50 }\);) Tj
T*
(    vertex\(cx + x - 8, y\);) Tj
T*
(    vertex\(cx + x + 8, y\);) Tj
T*
(  }) Tj
T*
(  endShape\(\);) Tj
T*
() Tj
T*
(------------------------------------------------------------) Tj
T*
(WORKFLOW 9: TERRAIN / HEIGHT MAP) Tj
T*
(------------------------------------------------------------) Tj
T*
(Use wave output as a height:) Tj
T*
(  const h = Waves.wave\(x + t, 'classicSine', null, { amplitude: 40 }\);) Tj
T*
(  vertex\(x, h, y\);) Tj
T*
() Tj
T*
(------------------------------------------------------------) Tj
T*
(WORKFLOW 10: TYPOGRAPHY / BASELINE WAVE) Tj
T*
(------------------------------------------------------------) Tj
T*
(Shift text positions by a wave:) Tj
T*
(  const offset = Waves.wave\(i * 20 + t, 'classicSine', null, { amplitude: 12 }\);) Tj
T*
(  text\(char, x, y + offset\);) Tj
T*
() Tj
T*
(------------------------------------------------------------) Tj
T*
(WORKFLOW 11: AUDIO-REACTIVE \(OPTIONAL\)) Tj
T*
(------------------------------------------------------------) Tj
T*
(If you use p5.sound, you can modulate amplitude by volume:) Tj
T*
(  const amp = mic.getLevel\(\) * 200 + 20;) Tj
T*
(  const x = Waves.wave\(y + t, 'classicSine', null, { amplitude: amp }\);) Tj
T*
() Tj
T*
(------------------------------------------------------------) Tj
T*
(WORKFLOW 12: FULL PLAY MODE \(INTERACTIVE SKETCH\)) Tj
T*
(------------------------------------------------------------) Tj
T*
(Use mouse or keyboard to control wave choice and amplitude:) Tj
T*
(  let waveName = 'classicSine';) Tj
T*
(  let amp = 80;) Tj
T*
() Tj
T*
(  function keyPressed\(\) {) Tj
T*
(    if \(key === '1'\) waveName = 'classicSine';) Tj
T*
(    if \(key === '2'\) waveName = 'zigZagSine';) Tj
T*
(    if \(key === '3'\) waveName = 'triangle';) Tj
T*
(  }) Tj
T*
() Tj
T*
(  function draw\(\) {) Tj
T*
(    amp = map\(mouseX, 0, width, 20, 160\);) Tj
T*
(    const x = Waves.wave\(y + t, waveName, null, { amplitude: amp }\);) Tj
T*
(  }) Tj
T*
() Tj
T*
(------------------------------------------------------------) Tj
T*
(ADVANCED OPTIONS) Tj
T*
ET
endstream
