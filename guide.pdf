stream
BT
/F1 11 Tf
54 738 Td
14 TL
(------------------------------------------------------------) Tj
T*
(Use the wave output as XZ offsets for a 3D grid:) Tj
T*
(  const o = Waves.wave\(y + t, 'classicSine', null, { axis: 'xz', amplitude: 60 }\);) Tj
T*
(  translate\(x + o.x, 0, y + o.z\);) Tj
T*
() Tj
T*
(------------------------------------------------------------) Tj
T*
(WORKFLOW 3: COLOR PATTERN) Tj
T*
(------------------------------------------------------------) Tj
T*
(Map the wave output into color values:) Tj
T*
(  const w = Waves.wave\(y + t, 'classicSine', null, { amplitude: 1, normalize: true, range: [0, 1] }\);) Tj
T*
(  const hue = 200 + w * 120;) Tj
T*
(  stroke\(hue, 80, 90\);) Tj
T*
() Tj
T*
(------------------------------------------------------------) Tj
T*
(WORKFLOW 4: FLOW FIELD \(DIRECTION MAP\)) Tj
T*
(------------------------------------------------------------) Tj
T*
(Use the wave as an angle that turns a vector field:) Tj
T*
(  const angle = Waves.wave\(x + y + t, 'classicSine', null, { amplitude: TWO_PI }\);) Tj
T*
(  const v = p5.Vector.fromAngle\(angle\);) Tj
T*
(  line\(x, y, x + v.x * 10, y + v.y * 10\);) Tj
T*
() Tj
T*
(------------------------------------------------------------) Tj
T*
(WORKFLOW 5: ROTATION / OSCILLATION) Tj
T*
(------------------------------------------------------------) Tj
T*
(Rotate shapes using the wave output:) Tj
T*
(  const r = Waves.wave\(y + t, 'classicSine', null, { amplitude: PI / 6 }\);) Tj
T*
(  rotate\(r\);) Tj
T*
() Tj
T*
(------------------------------------------------------------) Tj
T*
(WORKFLOW 6: MOTION PATH) Tj
T*
(------------------------------------------------------------) Tj
T*
(Use wave output as a path offset:) Tj
T*
(  const x = centerX + Waves.wave\(y + t, 'classicSine', null, { amplitude: 60 }\);) Tj
T*
(  const y = i * 10;) Tj
T*
(  circle\(x, y, 4\);) Tj
T*
() Tj
T*
(------------------------------------------------------------) Tj
T*
(WORKFLOW 7: PARTICLES) Tj
T*
(------------------------------------------------------------) Tj
T*
(Use wave output as a force or drift:) Tj
T*
(  const drift = Waves.wave\(p.y + t, 'classicSine', null, { amplitude: 0.6 }\);) Tj
T*
(  p.vx += drift;) Tj
T*
() Tj
T*
(------------------------------------------------------------) Tj
T*
(WORKFLOW 8: RIBBON / STRIP) Tj
T*
(------------------------------------------------------------) Tj
T*
(Use wave output to offset a polyline, then draw as a strip:) Tj
T*
(  beginShape\(TRIANGLE_STRIP\);) Tj
T*
ET
endstream
